plot(fit_step)
library(MASS)
df <- Melanoma
#convert factors into factors
df$ulcer <- as.factor(df$ulcer)
df$sex <- as.factor(df$sex)
df$status <- as.factor(df$status)
?Melanoma
#Full model
fit <- lm(thickness ~ ., data = df)
View(df)
View(df)
summary(fit)
#Stepwise regression to reduce the number of parameters (variables)
fit_step <- step(fit, k = log(nrow(df)))
summary(fit_step)
library(caret)
trainDF <- createDataPartition(df$thickness, p = 0.8, list = F)
trainData <- df[trainDF,]
testData <- df[-trainDF,]
#Repeat the process BUT on the train set only!
#Full model
fit <- lm(thickness ~ ., data = trainData)
summary(fit_step)
summary(fit)
#Reduce the model to remove redundancies
step_fit <- step(fit, k = log(nrow(trainData)))
plot(step_fit)
#Let's see how it performs on unseen data (1 itteration)
pred <- predict.lm(step_fit, testData)
testData$pred <- pred
#How well did it do in this itteration?
cor(testData$salary, testData$pred)^2
inTrain <- createDataPartition(df$salary, p = 0.8, list = F)
trainData <- df[inTrain,]
testData <- df[-inTrain,]
#Full model on train data
fit <- lm(salary ~ ., data = trainData)
summary(fit)
step_fit <- step(fit, k = log(nrow(trainData)))
summary(step_fit)
plot(step_fit)
cor(testData$salary, testData$pred)^2
#How well did it do in this itteration?
cor(testData$pred, testData$salary)^2
View(trainData)
View(trainData)
#Let's see how it performs on unseen data (1 itteration)
pred <- predict.lm(step_fit, testData)
testData$pred <- pred
View(testData)
View(testData)
#How well did it do in this itteration?
cor(testData$pred, testData$thickness)^2
